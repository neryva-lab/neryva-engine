# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ── Data plane (shared with the Python runtime during the strangler window) ──
DATABASE_URL=postgresql://neryva:change-me@localhost:5432/neryva
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# ── Engine identity ──────────────────────────────────────────────────────────
ENGINE_BASE_URL=http://localhost:3001
# The web app's public base — auth email links (reset/verify) point here.
ENGINE_UI_BASE_URL=http://localhost:5173

# ── Module flags (ADR-005: flags default OFF in code; this env enables them
#    for the staging/dev deployment once each module's gate has passed) ────────
MODULES__CORPORATE_ENABLED=true
MODULES__IDENTITY_ENABLED=false
MODULES__ORGANIZATIONS_ENABLED=false
MODULES__CONSOLE_ENABLED=false
MODULES__BILLING_ENABLED=false
MODULES__AGENT_STUDIO_ENABLED=false
MODULES__DEPLOYMENT_ENABLED=false
MODULES__WEBHOOKS_ENABLED=false
MODULES__CHANNELS_ENABLED=false
MODULES__NOTIFICATIONS_ENABLED=false
MODULES__STAFF_ENABLED=false
MODULES__KEYS_ENABLED=false
MODULES__CONFIG_PUBLISH_ENABLED=false
MODULES__SATELLITES_ENABLED=false

# ── Billing / metering ───────────────────────────────────────────────────────
# Cron for the B-5 cost-anomaly scan (default: daily 03:15 UTC).
BILLING_ANOMALY_CRON=15 3 * * *
# Ingest cost posture: derive | enforce | trust (see price-catalog.service).
BILLING_COST_VALIDATION=derive
# Org deletion grace window (days) before the purge job erases engine-owned rows.
ORG_DELETION_GRACE_DAYS=30

# ── Identity / OP ────────────────────────────────────────────────────────────
# Issuer of the first-party OP. Path-scoped until extraction (doc-06 Q2).
# MUST be the browser-facing origin: the provider absolutizes its redirects
# from it, and host-only OP cookies break across origins. Dev browsers hit
# the website (:3000, Vite /engine proxy); production uses the public origin.
IDENTITY_ISSUER=http://localhost:3000/engine/auth
# Audience the engine's own APIs accept on L1/L3 JWTs.
IDENTITY_API_AUDIENCE=neryva-engine
# RS256 private key (PKCS#8 PEM). Production refuses auto-generated keys:
# generate with:  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
IDENTITY_JWT_SIGNING_KEY_FILE=./secrets/oidc-signing.pem
# Optional previous key kept served during rotation overlap (>= 2x access TTL).
IDENTITY_JWT_SIGNING_KEY_PREVIOUS_FILE=
# Cookie signing keys (comma-separated long random strings).
IDENTITY_COOKIE_KEYS=change-me-cookie-key-1,change-me-cookie-key-2
# Allow ephemeral dev keys ONLY outside production.
IDENTITY_ALLOW_DEV_KEYS=false
IDENTITY_ACCESS_TTL_SECONDS=900
IDENTITY_REFRESH_TTL_SECONDS=1209600
IDENTITY_CODE_TTL_SECONDS=60
IDENTITY_EMAIL_CODE_TTL_SECONDS=600
IDENTITY_EMAIL_CODE_MAX_ATTEMPTS=5
IDENTITY_JWKS_CACHE_TTL_SECONDS=300

# ── Step-up MFA proofs (net-new TS semantics, kernel C11) ────────────────────
# 32+ byte secret (base64 or hex). File variant wins when both are set.
MFA_PROOF_SIGNING_KEY=
MFA_PROOF_SIGNING_KEY_FILE=./secrets/mfa-proof.key
MFA_PROOF_TTL_SECONDS=300

# ── Break-glass bootstrap key (mirrors the Python BOOTSTRAP_API_KEY) ─────────
BOOTSTRAP_API_KEY=

# ── Email (corporate E-1; resolves doc-06 Q1) ────────────────────────────────
EMAIL_TRANSPORT=file
EMAIL_FROM=Neryva <no-reply@neryva.com>
EMAIL_FILE_PATH=./var/outbox
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
EMAIL_RATE_LIMIT_PER_MINUTE=30
# Shared secret providers send on bounce/complaint webhooks (X-Webhook-Secret).
EMAIL_WEBHOOK_SECRET=
# Where contact-form team notifications land (unset = no team email).
CORPORATE_CONTACT_INBOX_EMAIL=

# ── Misc ─────────────────────────────────────────────────────────────────────
# 32-byte base64 key for envelope-encrypting recoverable secrets at rest
# (confidential client secrets). Required when service clients exist.
ENGINE_ENCRYPTION_KEY=

# ── Platform tooling (ADR-008) — each plane is optional and degrades loudly ──
# Traces (OpenTelemetry → OTLP/HTTP; local: the Jaeger block in the compose)
SERVICE_NAME=neryva-engine
# Trust X-Forwarded-* for client IP resolution (rate limits, audit trails).
# true = behind a trusted proxy/LB (default); false = directly internet-facing.
TRUST_PROXY=true
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Error tracking (unset = off)
SENTRY_DSN=
# Object storage (S3 / MinIO / R2) — configured when bucket+region+keys are set
# (local: the MinIO block in the compose; buckets: neryva-covers public-read)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
# Cloudflare Turnstile on the public forms (unset = off; set = required, fail-closed)
TURNSTILE_SECRET_KEY=

# ── Social login (doc-06 Δ1) — enable per provider by filling credentials ───
# Redirect URI to register at each developer console (same for all):
#   {ENGINE_BASE_URL}/login/social/callback/{provider}
IDENTITY_SOCIAL_GOOGLE_CLIENT_ID=
IDENTITY_SOCIAL_GOOGLE_CLIENT_SECRET=
IDENTITY_SOCIAL_GITHUB_CLIENT_ID=
IDENTITY_SOCIAL_GITHUB_CLIENT_SECRET=
# Apple: the ES256 p8 private key file from developer.apple.com (Sign in with Apple key)
IDENTITY_SOCIAL_APPLE_CLIENT_ID=
IDENTITY_SOCIAL_APPLE_TEAM_ID=
IDENTITY_SOCIAL_APPLE_KEY_ID=
IDENTITY_SOCIAL_APPLE_PRIVATE_KEY_FILE=./secrets/apple-signin.p8
# Microsoft (Entra ID v2): tenant = common | organizations | consumers | <guid>
IDENTITY_SOCIAL_MICROSOFT_CLIENT_ID=
IDENTITY_SOCIAL_MICROSOFT_CLIENT_SECRET=
IDENTITY_SOCIAL_MICROSOFT_TENANT=common

# ── Channel plane (Phase C) — Messenger / WhatsApp / Telegram / web widget ───
# Per-account credentials are sealed in the DB via the console; these are the
# platform-wide bounds only.
CHANNELS__MAX_ACCOUNTS_PER_ORG=25
# Widget session TTL (seconds; sliding on activity, hard cap 24h)
CHANNELS__WEB_SESSION_TTL_SECONDS=43200
# Per-session inbound message cap per rolling hour (abuse/cost control)
CHANNELS__WEB_SESSION_HOURLY_MESSAGES=30
# Bounded raw webhook envelope stored for replay/diagnostics (bytes)
CHANNELS__WEBHOOK_MAX_EVENT_BYTES=65536
