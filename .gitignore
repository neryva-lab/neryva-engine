# ── Secrets & environment — NEVER commit ────────────────────────────────────
# The OP signing key, MFA proof key, and any local .env live here (see
# src/README.md). secrets/ is referenced by .env.example defaults.
.env
.env.*
!.env.example
secrets/
*.pem
*.key
!drizzle/meta/*

# ── Dependencies & build output ─────────────────────────────────────────────
node_modules/
dist/
build/
*.tsbuildinfo

# ── Runtime artifacts ───────────────────────────────────────────────────────
# Dev email transport outbox (EMAIL_FILE_PATH) and general scratch
var/
*.log
logs/
pids/
*.pid

# Local databases / test artifacts (mirrors the studio repo's hygiene rule:
# SQLite test DBs were committed by accident once — never again)
*.db
*.sqlite
*.sqlite3

# ── Test & coverage ─────────────────────────────────────────────────────────
coverage/
.nyc_output/
junit*.xml

# ── Tooling caches ──────────────────────────────────────────────────────────
.eslintcache
.ruff_cache/
.mypy_cache/
.pytest_cache/
.DS_Store
Thumbs.db
legacy

# ── Scratch / local probes — never commit ───────────────────────────────────
# Live smoke and Connect probes created during Windows-native bring-up.
zz-*.ts
zz-*.mjs
zz-*.js
query

# ── Windows-native dev runner (local only, never commit) ─────────────────────
# Production uses Docker (ops/docker-compose.yml). dev_scripts/ is the
# Windows-without-Docker lane: native Postgres + Memurai Redis + MinIO binary
# + concurrently. Kept out of the repo so `git status` stays clean on
# Windows workstations; shared docs live in docs/frontend/ + ops/README.md.
# README + example env are intentionally tracked as documentation for the lane.
# (dev_scripts/* pattern allows negated files inside to be tracked; plain dev_scripts/ would ignore the whole dir)
var/keys
!dev_scripts/.gitkeep
!dev_scripts/README.md
!dev_scripts/.env.windows.example
dev_scripts/bin
# cutover CLI resume state (never commit)
.cutover-state.json
*.rdb
