# Windows-native dev .env — copy to engine/.env
# Production uses managed services (ops/docker-compose.yml). This is the
# native lane: local Postgres (EDB), Memurai Redis, MinIO binary.
# See engine/.env.example for full reference (keys, S3, billing, etc.).

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ── Data plane (localhost-native) ─────────────────────────────────────────
# Postgres: EDB 17 on Windows. User neryva/neryva DB neryva must exist:
#   psql -U postgres -c "CREATE USER neryva WITH PASSWORD 'neryva' CREATEDB;"
#   psql -U postgres -c "CREATE DATABASE neryva OWNER neryva;"
#   psql neryva -c "CREATE EXTENSION vector;"
DATABASE_URL=postgresql://neryva:neryva@127.0.0.1:5432/neryva
DATABASE_POOL_MAX=10
REDIS_URL=redis://127.0.0.1:6379

ENGINE_BASE_URL=http://localhost:3001
ENGINE_UI_BASE_URL=http://localhost:3000

# ── Engine→Studio dispatch (REQUIRED for live runs) ───────────────────────
# Without this, outbox dispatch skips and runs stay ACCEPTED (see runtime-control.client.ts).
NERYVA_RUNTIME_BASE_URL=http://localhost:8080

# ── Object storage (MinIO binary at dev_scripts/bin/minio.exe) ────────────
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=neryva-uploads
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/neryva-uploads
# MinIO root creds (dev only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Module flags (enable what you test; mirror your Docker .env) ───────────
MODULES__CORPORATE_ENABLED=true
MODULES__IDENTITY_ENABLED=true
MODULES__ORGANIZATIONS_ENABLED=true
MODULES__CONSOLE_ENABLED=true
MODULES__KEYS_ENABLED=true
MODULES__BILLING_ENABLED=true
MODULES__NOTIFICATIONS_ENABLED=true
MODULES__AGENT_STUDIO_ENABLED=true
MODULES__CONFIG_PUBLISH_ENABLED=true

# ── Identity / OP (dev keys allowed; prod fails closed) ────────────────────
IDENTITY_ISSUER=http://localhost:3001/auth
IDENTITY_API_AUDIENCE=neryva-engine
IDENTITY_ALLOW_DEV_KEYS=true
IDENTITY_COOKIE_KEYS=dev-cookie-key-1-change-me,dev-cookie-key-2-change-me

# ── Studio runtime-control (when run via dev_scripts/dev.ps1) ──────────────
# These are set by dev.ps1 for the studio process (PORT=8080, inline mode):
# PORT=8080
# EXECUTION_MODE=inline
# NERYVA_MCP_ENDPOINT=http://localhost:3001
# NERYVA_SERVICE_TOKEN=<16+ chars shared with Engine if required>
# LITELLM_BASE_URL / LITELLM_API_KEY — provider gateway (or leave empty for dry-run)
