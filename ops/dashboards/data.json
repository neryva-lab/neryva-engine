{
  "title": "Engine Data — RLS / DB / Outbox (Phase 1.7 skeleton)",
  "description": "Lock waits, slow queries, outbox lag, dead letters, RLS violations. Fill after first load test.",
  "panels": [
    {
      "title": "outboxLagSeconds (oldest PENDING)",
      "metric": "neryva_engine_outbox_lag_seconds",
      "query": "max(neryva_engine_outbox_lag_seconds) by (aggregate_type)"
    },
    {
      "title": "deadLettersTotal",
      "metric": "neryva_engine_dead_letters_total",
      "query": "sum(rate(neryva_engine_dead_letters_total[5m])) by (aggregate_type, reason)"
    },
    {
      "title": "lockWaitsTotal",
      "metric": "neryva_engine_lock_waits_total",
      "query": "sum(rate(neryva_engine_lock_waits_total[5m])) by (lock_type)"
    },
    {
      "title": "slowQueriesTotal",
      "metric": "neryva_engine_slow_queries_total",
      "query": "sum(rate(neryva_engine_slow_queries_total[5m])) by (query_family)"
    },
    {
      "title": "rlsViolationsTotal",
      "metric": "neryva_engine_rls_violations_total",
      "query": "sum(rate(neryva_engine_rls_violations_total[5m])) by (table)"
    },
    {
      "title": "pg pool — placeholder (add pg pool exporter or app gauge)",
      "metric": "neryva_engine_pg_pool_*",
      "query": "avg_over_time(neryva_engine_pg_pool_size[5m])"
    }
  ]
}
