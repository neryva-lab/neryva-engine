{
  "name": "@neryva/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Neryva platform engine — TypeScript/NestJS core (identity, organizations, console, corporate, metering). ADR-005/006/007.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=.env --watch dist/main.js",
    "start": "node dist/main.js",
    "migrate": "drizzle-kit migrate",
    "migrate:generate": "drizzle-kit generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\" \"docs/**/*.md\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:isolation": "vitest run --config vitest.isolation.config.ts",
    "test:property": "vitest run --config vitest.property.config.ts",
    "test:chaos": "vitest run --config vitest.chaos.config.ts",
    "test:load": "vitest run --config vitest.load.config.ts",
    "test:watch": "vitest",
    "templates:sync": "tsx src/scripts/sync-template-registry.ts",
    "cutover": "tsx src/cutover/cutover.ts",
    "cutover:smoke": "tsx src/cutover/smoke.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-fastify": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@fastify/cookie": "^11.1.2",
    "@neryva/mcp-contract": "file:../products/neryva_mcp/neryva-mcp-contract",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@node-rs/argon2": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.203.0",
    "@opentelemetry/instrumentation-fastify": "^0.51.0",
    "@opentelemetry/instrumentation-http": "^0.203.0",
    "@opentelemetry/instrumentation-ioredis": "^0.51.0",
    "@opentelemetry/instrumentation-pg": "^0.57.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.203.0",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "@sentry/node": "^10.0.0",
    "bullmq": "^5.30.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.11.3",
    "ioredis": "^5.4.0",
    "mongodb": "7.6.0",
    "oidc-provider": "^8.4.0",
    "pg": "^8.13.0",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^3.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "jiti": "^2.4.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}
